# =============================================================================
# Configura3D - Variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores antes de executar.
# =============================================================================

# Ambiente
NODE_ENV=development
PORT=3334
API_URL=http://localhost:3334
WEB_URL=http://localhost:5173

# Banco de dados (PostgreSQL primário)
DATABASE_URL="postgresql://configura3d:configura3d@localhost:5433/configura3d?schema=public"

# Redis (cache e filas - opcional no MVP)
REDIS_URL=redis://localhost:6379

# Autenticação / JWT
JWT_SECRET=troque-por-um-segredo-forte-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# CORS (origens permitidas do frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# Armazenamento de objetos (S3 compatível) - opcional no MVP (usa disco local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=configura3d
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# URL pública dos assets (ex: https://cdn.configura3d.com)
PUBLIC_ASSETS_URL=http://localhost:3334/assets

# Multiempresa - domínio padrão para páginas públicas
DEFAULT_TENANT_DOMAIN=localhost:5173

# Logs
LOG_LEVEL=debug
